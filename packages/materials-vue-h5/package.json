{
  "name": "@meumall/lowcode-materials-vue-h5",
  "version": "0.1.0",
  "description": "Vue H5 business materials for MeuMall low-code pages",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
