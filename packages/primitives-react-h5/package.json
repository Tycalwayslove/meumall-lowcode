{
  "name": "@meumall/lowcode-primitives-react-h5",
  "version": "0.1.0",
  "description": "React H5 runtime primitives for MeuMall low-code materials",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
